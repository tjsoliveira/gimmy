// Copy to Config/Secrets.xcconfig and fill in. That file is ignored by git.

// Bundle ID registered in the Google iOS OAuth client. Must be unique to you
// (a free Apple ID won't sign com.example.*). Example: com.seunome.gimmy
APP_BUNDLE_ID = com.seunome.gimmy

// Your Apple team ID (Xcode > Settings > Accounts). Only needed when building with Xcode.
DEVELOPMENT_TEAM =

// Google OAuth iOS client ID WITHOUT ".apps.googleusercontent.com".
// For 1234-abcd.apps.googleusercontent.com write 1234-abcd
GOOGLE_CLIENT_ID_PREFIX =

// ID of the "Controle de Treinos" spreadsheet (the part of its URL between /d/ and /edit).
SPREADSHEET_ID =
